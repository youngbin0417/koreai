# Copy to .env, fill only the keys you use; never commit .env.
# Linux: chmod 600 .env. Restart KoreAI after edits.
# Existing shell/systemd variables take precedence. No VITE_ secrets.
# Each provider needs its own approval. ACTIONS are explicit account grants.
# Read actions below are examples; writes start with no grants.

# DeepSeek V4.1 Flash (fixed model: deepseek-flash). Optional legacy encrypted-key fallback.
DEEPSEEK_API_KEY=

# Motif (Morfac) Chat Completions, model motif/motif-3. Chosen per new conversation.
MORPH_API_KEY=

# Server options. HTTP key transmission remains disabled by default.
KOREAI_PUBLIC_URL=
KOREAI_MASTER_KEY_FILE=
KOREAI_ALLOW_SEOUL_SUBWAY_HTTP=0
KOREAI_ALLOW_SEOUL_BIKE_HTTP=0

# Optional local MCP/CLI client; its token grants are still configured in the dashboard.
KOREAI_URL=http://127.0.0.1:4318
KOREAI_TOKEN=

# 네이버 사용자
KOREAI_NAVER_USER_ACCESS_TOKEN=
KOREAI_NAVER_USER_ACTIONS=
# Optional writes (still require job approval): naver.cafe.join,naver.cafe.publish,naver.calendar.create

# 밴드
KOREAI_BAND_ACCESS_TOKEN=
KOREAI_BAND_ACTIONS=band.bands,band.posts,band.post
# Optional writes (still require job approval): band.publish

# 카카오 사용자
KOREAI_KAKAO_USER_ACCESS_TOKEN=
KOREAI_KAKAO_USER_ACTIONS=
# Optional writes (still require job approval): kakao.message.self

# 카카오 지도·다음 검색
KOREAI_KAKAO_APP_REST_API_KEY=
KOREAI_KAKAO_APP_ACTIONS=kakao.map.places,kakao.map.address,daum.search.web,daum.search.blog,daum.search.cafe

# 공공혜택
KOREAI_BENEFITS_SERVICE_KEY=
KOREAI_BENEFITS_ACTIONS=gov.benefits.list,gov.benefits.detail

# 기상청
KOREAI_KMA_SERVICE_KEY=
KOREAI_KMA_ACTIONS=kma.observation

# 에어코리아
KOREAI_AIRKOREA_SERVICE_KEY=
KOREAI_AIRKOREA_ACTIONS=airkorea.forecast

# 대중교통 TAGO
KOREAI_TAGO_SERVICE_KEY=
KOREAI_TAGO_ACTIONS=tago.bus.arrivals,tago.cities,tago.bus.stops

# E-Gen
KOREAI_EGEN_SERVICE_KEY=
KOREAI_EGEN_ACTIONS=egen.hospitals.search

# 건강보험심사평가원
KOREAI_HIRA_SERVICE_KEY=
KOREAI_HIRA_ACTIONS=hira.hospitals.search

# 나이스 교육정보
KOREAI_NEIS_API_KEY=
KOREAI_NEIS_ACTIONS=neis.schools.search,neis.meals

# 영화관입장권
KOREAI_KOBIS_API_KEY=
KOREAI_KOBIS_ACTIONS=kobis.boxoffice.daily

# 공연예술
KOREAI_KOPIS_API_KEY=
KOREAI_KOPIS_ACTIONS=kopis.performances.search,kopis.performances.get

# 한국관광공사
KOREAI_TOURAPI_SERVICE_KEY=
KOREAI_TOURAPI_ACTIONS=tourapi.regions.list,tourapi.places.search,tourapi.festivals.search

# 식품안전나라
KOREAI_FOODSAFETY_API_KEY=
KOREAI_FOODSAFETY_ACTIONS=foodsafety.recalls.search

# LH 공고
KOREAI_LH_SERVICE_KEY=
KOREAI_LH_ACTIONS=lh.notices.search

# 국가통계
KOREAI_KOSIS_API_KEY=
KOREAI_KOSIS_ACTIONS=kosis.aging.search

# TMAP
KOREAI_TMAP_APP_KEY=
KOREAI_TMAP_ACTIONS=tmap.route.car

# 고용24
KOREAI_WORK24_AUTH_KEY=
KOREAI_WORK24_ACTIONS=work24.jobs.search,work24.regions.list

# 서울 지하철 도착·시간표
KOREAI_SEOUL_SUBWAY_API_KEY=
KOREAI_SEOUL_SUBWAY_ACTIONS=seoul-subway.arrivals,seoul-subway.timetable

# 서울 지하철 경로·환승
KOREAI_SEOUL_SUBWAY_ROUTE_SERVICE_KEY=
KOREAI_SEOUL_SUBWAY_ROUTE_ACTIONS=seoul-subway.route

# 전기차 충전소
KOREAI_EV_CHARGERS_SERVICE_KEY=
KOREAI_EV_CHARGERS_ACTIONS=ev-chargers.search

# 오피넷
KOREAI_OPINET_API_KEY=
KOREAI_OPINET_ACTIONS=opinet.regions.list,opinet.stations.cheapest,opinet.stations.get

# 따릉이
KOREAI_SEOUL_BIKE_API_KEY=
KOREAI_SEOUL_BIKE_ACTIONS=seoul-bike.stations

# 치지직
KOREAI_CHZZK_CLIENT_ID=
KOREAI_CHZZK_CLIENT_SECRET=
KOREAI_CHZZK_ACTIONS=chzzk.lives.list,chzzk.channels.get

# 도서관 정보나루
KOREAI_LIBRARY_NARU_API_KEY=
KOREAI_LIBRARY_NARU_ACTIONS=library-naru.libraries.search,library-naru.collections.search,library-naru.book.status
