{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "react-jsx", "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "ui", "tests", "vite.config.ts"]
}
