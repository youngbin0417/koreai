{
  "name": "koreai",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "한국 생활 서비스를 연결하는 로컬 에이전트 게이트웨이",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.17.0" },
  "scripts": {
    "dev": "tsx src/server.ts --dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server.js",
    "mcp": "tsx src/mcp.ts",
    "client": "tsx src/cli.ts",
    "doctor": "tsx src/doctor.ts",
    "connector:new": "tsx src/connector-scaffold.ts",
    "ai:key": "tsx src/ai/cli.ts key",
    "ai:check": "tsx src/ai/cli.ts check",
    "ai:ask": "tsx src/ai/cli.ts ask",
    "ai:test": "tsx src/ai/live-test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ai": "tsx --test --test-concurrency=1 tests/deepseek.test.ts tests/lifestyle-connections.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ajv": "^8.17.1",
    "express": "^5.1.0",
    "iconv-lite": "^0.7.0",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
